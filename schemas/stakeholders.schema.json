{
  "$ref": "#/definitions/stakeholders",
  "definitions": {
    "stakeholders": {
      "type": "object",
      "properties": {
        "customer": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "people": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "email"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "influence": {
                "type": "string",
                "enum": [
                  "economic_buyer",
                  "champion",
                  "user",
                  "blocker",
                  "unknown"
                ]
              },
              "sentiment": {
                "type": "string",
                "enum": [
                  "positive",
                  "neutral",
                  "negative",
                  "unknown"
                ],
                "default": "unknown"
              },
              "last_contact": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "name",
              "role",
              "influence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "customer",
        "people"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
